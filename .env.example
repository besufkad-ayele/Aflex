# ==============================================================================
# AFLEX Academy Web Portal - Environment Variables Template
# ==============================================================================

# Google Gemini API Key (Required for Sululta Steward AI agent: /api/faq-agent)
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase Infrastructure Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_public_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_secret_here"
SUPABASE_ACCESS_TOKEN="your_personal_access_token_here"
SUPABASE_PROJECT_REF="your-project-ref"

# Cache Invalidation Secret (shared between Supabase Database Webhooks & /api/revalidate)
# Generate with: openssl rand -hex 24
REVALIDATION_SECRET_TOKEN="generate_strong_secret_token_here"
