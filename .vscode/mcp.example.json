{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server"],
      "env": {
        "SUPABASE_URL": "https://your-project-ref.supabase.co",
        "SUPABASE_KEY": "your_supabase_service_role_or_anon_key",
        "SUPABASE_ACCESS_TOKEN": "your_supabase_personal_access_token"
      }
    }
  }
}
